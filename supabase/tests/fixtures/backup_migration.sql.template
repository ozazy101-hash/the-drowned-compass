begin;
create extension if not exists pgtap with schema extensions;
select no_plan();
create temporary table before_backup_migration as select to_jsonb(s) data from public.character_slots s order by position;
-- __COMBAT_ENTRIES_MIGRATION__
-- __LIMITED_RESOURCES_MIGRATION__
-- __FEATURES_STORY_MIGRATION__
-- __SURVIVAL_MIGRATION__
-- __CHARACTER_CLASSES_MIGRATION__
-- __INVENTORY_MIGRATION__
-- __CONDITIONS_MIGRATION__
-- __FEATURED_ATTACKS_MIGRATION__
-- __HEALTH_MIGRATION__
-- __MAGIC_MIGRATION__
-- __RESTS_MIGRATION__
-- __BACKUP_MIGRATION__
select results_eq($$select to_jsonb(s) from public.character_slots s order by position$$,
  $$select data from before_backup_migration$$, 'migration preserves all six slots, claims, data and versions');
insert into auth.users (
  instance_id, id, aud, role, email, encrypted_password, email_confirmed_at,
  raw_app_meta_data, raw_user_meta_data, created_at, updated_at
) values
  (
    '00000000-0000-0000-0000-000000000000',
    '30000000-0000-4000-8000-000000000001',
    'authenticated', 'authenticated', 'players@drowned-compass.test', '', now(),
    '{}', '{}', now(), now()
  ),
  (
    '00000000-0000-0000-0000-000000000000',
    '30000000-0000-4000-8000-000000000002',
    'authenticated', 'authenticated', 'dm@drowned-compass.test', '', now(),
    '{}', '{}', now(), now()
  ),
  (
    '00000000-0000-0000-0000-000000000000',
    '30000000-0000-4000-8000-000000000003',
    'authenticated', 'authenticated', 'overview-outsider@drowned-compass.test', '', now(),
    '{}', '{}', now(), now()
  );

set local role authenticated;
set local "request.jwt.claim.sub" = '30000000-0000-4000-8000-000000000001';

select results_eq(
  $$
    update public.character_slots
    set claimed_at = now(),
      claimed_by = '30000000-0000-4000-8000-000000000001',
      player_name = 'Mara', character_name = 'Neris Vale',
      primary_class = 'Rogue', subclass = 'Thief', species = 'Human',
      background = 'Sailor', level = 3,
      strength = 9, dexterity = 17, constitution = 13,
      intelligence = 14, wisdom = 12, charisma = 11,
      version = 1, updated_at = now()
    where position = 1
    returning character_name
  $$,
  array['Neris Vale'],
  'Player can prepare a complete claimed Character Record'
);


reset role;
select set_config('test.backup_slot',(select id::text from public.character_slots where position=1),true);
select is(public.edit_character_class(current_setting('test.backup_slot')::uuid,'primary','Fighter',3,false,1),true,'prepare primary class through guarded command');
select is(public.edit_character_class(current_setting('test.backup_slot')::uuid,'11111111-1111-4111-8111-111111111111','Wizard',1,false,0),true,'prepare multiclass through guarded command');
update public.character_slots set max_hit_points=20, overview_field_versions='{"maxHitPoints":2,"override.initiative":1}',derived_overrides='{"initiative":0}' where position=1;
update public.character_classes set name='Fighter',level=3,version=2 where slot_id=current_setting('test.backup_slot')::uuid and entry_id='primary';
insert into public.character_classes(slot_id,entry_id,name,level,deleted,version) values
(current_setting('test.backup_slot')::uuid,'11111111-1111-4111-8111-111111111112','Rogue',1,true,2);
insert into public.character_survival(slot_id,state) values(current_setting('test.backup_slot')::uuid,'{"current":0,"temporary":7,"successes":2,"failures":1,"unconscious":true,"inspiration":true,"version":3,"secret":"DO-NOT-EXPORT","undo":{"before":{"current":2,"temporary":7,"access_token":"DO-NOT-EXPORT"},"maximumVersion":2,"label":"subtract","credential":"DO-NOT-EXPORT"}}');
insert into public.limited_resources(id,slot_id,name,current,maximum,recovery,position,important,deleted,version) values
('11111111-1111-4111-8111-111111111110',current_setting('test.backup_slot')::uuid,'Second Wind',0,1,'Short Rest',1024,true,false,2),
('11111111-1111-4111-8111-111111111113',current_setting('test.backup_slot')::uuid,'Removed resource',0,0,'Manual',2048,false,true,3);
insert into public.character_conditions(slot_id,id,standard,label,deleted,version) values
(current_setting('test.backup_slot')::uuid,'srd.Blinded','Blinded','Blinded',false,1),
(current_setting('test.backup_slot')::uuid,'custom.11111111-1111-4111-8111-111111111114',null,'Sea curse',true,2);
insert into public.character_magic(slot_id,id,kind,state,version) values
(current_setting('test.backup_slot')::uuid,'srd-5.2.1:acid-splash','spell','{"catalogId":"srd-5.2.1:acid-splash","name":"","level":0,"availability":"Prepared","source":"","notes":"Aim away from crew","deleted":false}',2),
(current_setting('test.backup_slot')::uuid,'custom.11111111-1111-4111-8111-111111111115','spell','{"catalogId":null,"name":"Sea Lantern","level":2,"availability":"Feature granted","source":"Moon gift","notes":"Custom spell notes","deleted":true}',3),
(current_setting('test.backup_slot')::uuid,'slots.1','slots','{"level":1,"maximum":3,"remaining":1}',2),
(current_setting('test.backup_slot')::uuid,'slots.2','slots','{"level":2,"maximum":0,"remaining":0}',1);
insert into public.character_inventory_entries(slot_id,entry_id,kind,title,body,rank,deleted,version) values
(current_setting('test.backup_slot')::uuid,'currency.gp','gp','','12',0,false,3),
(current_setting('test.backup_slot')::uuid,'item.11111111-1111-4111-8111-111111111116','equipment','Cutlass','Weathered hilt',4,false,2),
(current_setting('test.backup_slot')::uuid,'item.11111111-1111-4111-8111-111111111117','magic','Moon stone','Removed item',5,true,3);
insert into public.character_text_entries(slot_id,entry_id,kind,title,body,deleted,version) values
(current_setting('test.backup_slot')::uuid,'feature.11111111-1111-4111-8111-111111111118','feat','Sea Legs','Player-authored feature',false,2),
(current_setting('test.backup_slot')::uuid,'story.backstory','backstory','','Raised aboard a merchant ship',false,1),
(current_setting('test.backup_slot')::uuid,'story.notes','notes','','Character notes are included',false,4),
(current_setting('test.backup_slot')::uuid,'feature.11111111-1111-4111-8111-111111111119','class','Removed feature','Tombstone',true,3);
insert into public.character_combat_entries(id,slot_id,details,rank,deleted,version) values('11111111-1111-4111-8111-111111111120',current_setting('test.backup_slot')::uuid,'{"kind":"attack","category":"melee","name":"Cutlass","attackBonus":"4","ability":"strength","range":"5 feet","damage":"1d6 + 2","damageType":"Slashing","notes":"Keep reminder"}',1024,false,2);
insert into public.character_primary_attacks(slot_id,primary_id,featured_ids,version) values(current_setting('test.backup_slot')::uuid,null,array['11111111-1111-4111-8111-111111111120'::uuid],3) on conflict(slot_id) do update set featured_ids=excluded.featured_ids,primary_id=excluded.primary_id,version=excluded.version;
insert into public.character_rest_receipts(slot_id,command) values(current_setting('test.backup_slot')::uuid,'{"secret":"DO-NOT-EXPORT","operationId":"22222222-2222-4222-8222-222222222222"}');
create temporary table backup_rows_before as select (select jsonb_agg(to_jsonb(s)) from public.character_slots s) slots,(select jsonb_agg(to_jsonb(s)) from public.character_survival s) survival,(select jsonb_agg(to_jsonb(m)) from public.character_magic m) magic;
select ok(has_function_privilege('authenticated','public.export_party_data_snapshot()','EXECUTE'),'authenticated can call snapshot capability boundary');
select ok(not has_function_privilege('anon','public.export_party_data_snapshot()','EXECUTE'),'anonymous cannot execute backup RPC');
select ok(not has_function_privilege('authenticated','public.party_backup_fields(jsonb,text[])','EXECUTE'),'private projection helper cannot be invoked with custom allowlist');
select is((select provolatile::text from pg_proc where oid='public.export_party_data_snapshot()'::regprocedure),'s','snapshot function uses single calling-statement snapshot');
set local role authenticated;
set local "request.jwt.claim.sub"='30000000-0000-4000-8000-000000000001';
select throws_ok($$select public.export_party_data_snapshot()$$,'42501',null,'Player membership cannot invoke DM backup');
set local "request.jwt.claims"='{"role":"authenticated","user_metadata":{"role":"dungeon-master"}}';
select throws_ok($$select public.export_party_data_snapshot()$$,'42501',null,'forged client DM claim cannot override stored Player membership');
set local "request.jwt.claim.sub"='30000000-0000-4000-8000-000000000003';
select throws_ok($$select public.export_party_data_snapshot()$$,'42501',null,'nonmember cannot export');
set local "request.jwt.claim.sub"='30000000-0000-4000-8000-000000000002';
select lives_ok($$select public.export_party_data_snapshot()$$,'stored DM Party membership authorizes backup');
select set_config('test.backup_snapshot',public.export_party_data_snapshot()::text,true);
select is(public.export_party_data_snapshot(),current_setting('test.backup_snapshot')::jsonb,'repeated saved snapshot is deterministic');
select is(current_setting('test.backup_snapshot')::jsonb->>'name','The Drowned Compass','actual Party name setting included');
select is(jsonb_array_length(current_setting('test.backup_snapshot')::jsonb->'slots'),6,'all six Character Slots included');
select is(current_setting('test.backup_snapshot')::jsonb#>'{slots,1,character}','null'::jsonb,'unclaimed slot explicit');
select is(current_setting('test.backup_snapshot')::jsonb#>>'{slots,0,character,characterName}','Neris Vale','Character identity included');
select is(current_setting('test.backup_snapshot')::jsonb#>>'{slots,0,character,level}','4','multiclass total preserved');
select is(jsonb_array_length(current_setting('test.backup_snapshot')::jsonb#>'{slots,0,character,classes}'),3,'all class rows including tombstones retained');
select is(current_setting('test.backup_snapshot')::jsonb#>>'{slots,0,character,classes,1,deleted}','true','class tombstone retained');
select is(current_setting('test.backup_snapshot')::jsonb#>>'{slots,0,character,fieldVersions,maxHitPoints}','2','independent Overview versions retained');
select is(current_setting('test.backup_snapshot')::jsonb#>>'{slots,0,character,derivedOverrides,initiative}','0','zero override retained');
select is(current_setting('test.backup_snapshot')::jsonb#>>'{slots,0,character,survival,current}','0','zero HP retained');
select is(current_setting('test.backup_snapshot')::jsonb#>>'{slots,0,character,survival,temporary}','7','legacy Temporary HP retained');
select is(current_setting('test.backup_snapshot')::jsonb#>>'{slots,0,character,survival,successes}','2','death saves retained');
select is(current_setting('test.backup_snapshot')::jsonb#>>'{slots,0,character,survival,inspiration}','true','Heroic Inspiration retained');
select is(current_setting('test.backup_snapshot')::jsonb#>>'{slots,0,character,survival,undo,before,current}','2','allowlisted undo history retained');
select is(current_setting('test.backup_snapshot')::jsonb#>>'{slots,0,character,limitedResources,0,current}','0','resource current/max/timing snapshot retained');
select is(current_setting('test.backup_snapshot')::jsonb#>>'{slots,0,character,limitedResources,1,deleted}','true','resource tombstone retained');
select is(jsonb_array_length(current_setting('test.backup_snapshot')::jsonb#>'{slots,0,character,conditions}'),2,'standard and removed custom Conditions retained');
select is(current_setting('test.backup_snapshot')::jsonb#>>'{slots,0,character,magic,spells,0,name}','Sea Lantern','Custom Spell fully portable name retained');
select is(current_setting('test.backup_snapshot')::jsonb#>>'{slots,0,character,magic,spells,0,notes}','Custom spell notes','Custom Spell notes retained');
select is(current_setting('test.backup_snapshot')::jsonb#>>'{slots,0,character,magic,spells,1,catalogId}','srd-5.2.1:acid-splash','pinned catalog association retained');
select is(current_setting('test.backup_snapshot')::jsonb#>>'{slots,0,character,magic,slots,1,maximum}','0','zero configured slot maximum retained');
select is(jsonb_array_length(current_setting('test.backup_snapshot')::jsonb#>'{slots,0,character,inventory}'),3,'items/currency/tombstones included');
select is(current_setting('test.backup_snapshot')::jsonb#>>'{slots,0,character,inventory,0,body}','12','currency amount retained');
select is(current_setting('test.backup_snapshot')::jsonb#>>'{slots,0,character,textEntries,2,body}','Raised aboard a merchant ship','Character backstory included despite campaign exclusion');
select is(current_setting('test.backup_snapshot')::jsonb#>>'{slots,0,character,textEntries,3,body}','Character notes are included','Character notes included');
select is(current_setting('test.backup_snapshot')::jsonb#>>'{slots,0,character,combatEntries,entries,0,details,notes}','Keep reminder','Combat notes included');
select is(current_setting('test.backup_snapshot')::jsonb#>>'{slots,0,character,combatEntries,featuredIds,0}','11111111-1111-4111-8111-111111111120','featured attack selection retained');
select ok(current_setting('test.backup_snapshot') not like '%DO-NOT-EXPORT%','unknown nested fields and operational receipt excluded by backend allowlist');
select ok(current_setting('test.backup_snapshot') not like '%claimed_by%','auth ownership audit identifier excluded');
select ok(current_setting('test.backup_snapshot') not like '%updated_by%','auth audit fields excluded');
select ok(current_setting('test.backup_snapshot') not like '%party_members%','unrelated membership data excluded');
reset role;
select results_eq($$select (select jsonb_agg(to_jsonb(s)) from public.character_slots s),(select jsonb_agg(to_jsonb(s)) from public.character_survival s),(select jsonb_agg(to_jsonb(m)) from public.character_magic m)$$,$$select slots,survival,magic from backup_rows_before$$,'snapshot is read-only and does not mutate Character data');
update public.party_members set role='player' where user_id='30000000-0000-4000-8000-000000000002';
set local role authenticated;
select throws_ok($$select public.export_party_data_snapshot()$$,'42501',null,'server membership role downgrade revokes export immediately');
set local role anon;
reset "request.jwt.claim.sub";
select throws_ok($$select public.export_party_data_snapshot()$$,'42501',null,'anonymous RPC rejected');
select * from finish();
rollback;
