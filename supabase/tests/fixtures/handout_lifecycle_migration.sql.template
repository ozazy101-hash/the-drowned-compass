begin;
create extension if not exists pgtap with schema extensions;
select plan(25);
set local storage.allow_delete_query='true';
create temporary table handout_character_snapshot as select to_jsonb(s) data from public.character_slots s order by position;
-- Rebuild only content schema inside this rollback-only transaction, proving
-- the actual02→03 migrations preserve an existing usable private Handout.
drop table public.party_handouts cascade;
drop function public.change_party_handout(uuid,integer,uuid,text,text,uuid,text,text,integer);
drop function public.guard_handout_commit() cascade;
drop function public.guard_handout_object_cleanup() cascade;
drop function public.is_party_dm(uuid) cascade;
drop function public.can_manage_handout_object(text) cascade;
delete from storage.objects where bucket_id='party-handouts';
delete from storage.buckets where id='party-handouts';
-- __PRIVATE_HANDOUTS_MIGRATION__
insert into auth.users(id,email,raw_app_meta_data,raw_user_meta_data) values ('50000000-0000-4000-8000-000000000001','handout-lifecycle-dm@verification.test','{}','{}'),('50000000-0000-4000-8000-000000000002','handout-lifecycle-player@verification.test','{}','{}');
insert into public.party_members(party_id,user_id,role) values ('00000000-0000-4000-8000-000000000001','50000000-0000-4000-8000-000000000001','dungeon-master'),('00000000-0000-4000-8000-000000000001','50000000-0000-4000-8000-000000000002','player');
insert into storage.objects(bucket_id,name,metadata) values ('party-handouts','00000000-0000-4000-8000-000000000001/50000000-0000-4000-8000-000000000003','{"size":68,"mimetype":"image/png"}'),('party-handouts','00000000-0000-4000-8000-000000000001/50000000-0000-4000-8000-000000000004','{"size":68,"mimetype":"image/png"}');
insert into public.party_handouts(id,party_id,title,mime,size,digest) values('50000000-0000-4000-8000-000000000003','00000000-0000-4000-8000-000000000001','Existing letter','image/png',68,repeat('a',64));
create temporary table old_handout as select to_jsonb(h) data from public.party_handouts h;
-- __HANDOUT_LIFECYCLE_MIGRATION__
select results_eq($$select to_jsonb(h)-array['object_id','version','content_version','last_request_id','last_signature'] from public.party_handouts h$$,$$select data from old_handout$$,'03 migration preserves existing02 Handout metadata');
select is((select version from public.party_handouts),1,'existing Handout starts at version1');
select is((select object_id from public.party_handouts),'50000000-0000-4000-8000-000000000003'::uuid,'existing object path backfilled without moving files');
select is((select visibility from public.party_handouts),'private','existing private visibility retained');
set local role authenticated;
set local "request.jwt.claim.sub"='50000000-0000-4000-8000-000000000002';
select is((select count(*) from public.party_handouts),0::bigint,'Player cannot enumerate private Handout');
set local "request.jwt.claim.sub"='50000000-0000-4000-8000-000000000001';
select lives_ok($$select public.change_party_handout('50000000-0000-4000-8000-000000000003',1,'50000000-0000-4000-8000-000000000005','reveal')$$,'DM reveals existing Handout');
select is((select version from public.party_handouts),2,'accepted reveal advances version once');
set local "request.jwt.claim.sub"='50000000-0000-4000-8000-000000000002';
select is((select count(*) from public.party_handouts),1::bigint,'Player reads revealed metadata');
select is((select count(*) from storage.objects where bucket_id='party-handouts'),1::bigint,'Player sees only current revealed object, not staged replacement');
select throws_ok($$select public.change_party_handout('50000000-0000-4000-8000-000000000003',2,'50000000-0000-4000-8000-000000000006','withdraw')$$,'42501','Dungeon Master access is required to manage Handouts','Player lifecycle mutation denied');
set local role anon;
select throws_ok($$select * from public.party_handouts$$,'42501',null,'anonymous revealed metadata denied');
select is((select count(*) from storage.objects where bucket_id='party-handouts'),0::bigint,'anonymous revealed object denied');
set local role authenticated;
set local "request.jwt.claim.sub"='50000000-0000-4000-8000-000000000001';
select throws_ok($$select public.change_party_handout('50000000-0000-4000-8000-000000000003',2,'50000000-0000-4000-8000-000000000007','replace',null,'50000000-0000-4000-8000-000000000007',repeat('b',64),'image/png',68)$$,'P0001','Upload usable content before saving the Handout','missing replacement object rejects atomic update');
select is((select object_id from public.party_handouts),'50000000-0000-4000-8000-000000000003'::uuid,'failed replacement retains old reference');
select is((public.change_party_handout('50000000-0000-4000-8000-000000000003',1,'50000000-0000-4000-8000-000000000006','withdraw')->>'ok')::boolean,false,'stale action reports conflict');
select is((public.change_party_handout('50000000-0000-4000-8000-000000000003',1,'50000000-0000-4000-8000-000000000005','reveal')->'item'->>'version')::integer,2,'same current request retry does not repeat transition');
select lives_ok($$select public.change_party_handout('50000000-0000-4000-8000-000000000003',2,'50000000-0000-4000-8000-000000000004','replace',null,'50000000-0000-4000-8000-000000000004',repeat('b',64),'image/png',68)$$,'DM replacement switches current reference');
select ok((select title='Existing letter' and visibility='revealed' and version=3 and content_version=2 from public.party_handouts),'replacement retains title/visibility and increments content version');
set local "request.jwt.claim.sub"='50000000-0000-4000-8000-000000000002';
select is((select count(*) from storage.objects where name='00000000-0000-4000-8000-000000000001/50000000-0000-4000-8000-000000000003'),0::bigint,'old replaced object denied to Player');
select is((select count(*) from storage.objects where name='00000000-0000-4000-8000-000000000001/50000000-0000-4000-8000-000000000004'),1::bigint,'current replacement accessible to Player');
set local "request.jwt.claim.sub"='50000000-0000-4000-8000-000000000001';
select lives_ok($$select public.change_party_handout('50000000-0000-4000-8000-000000000003',3,'50000000-0000-4000-8000-000000000006','withdraw')$$,'DM withdraws');
set local "request.jwt.claim.sub"='50000000-0000-4000-8000-000000000002';
select is((select count(*) from public.party_handouts),0::bigint,'withdrawal removes Player listing');
set local "request.jwt.claim.sub"='50000000-0000-4000-8000-000000000001';
select is((select count(*) from storage.objects where name='00000000-0000-4000-8000-000000000001/50000000-0000-4000-8000-000000000004'),1::bigint,'DM retains withdrawn current object');
select is((public.change_party_handout('50000000-0000-4000-8000-000000000003',1,'50000000-0000-4000-8000-000000000005','reveal')->>'ok')::boolean,false,'old retry cannot reverse later withdrawal');
reset role;
select results_eq($$select to_jsonb(s) from public.character_slots s order by position$$,$$select data from handout_character_snapshot$$,'both content migrations leave Character Records intact');
select * from finish();rollback;
