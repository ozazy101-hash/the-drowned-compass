begin;
create extension if not exists pgtap with schema extensions;
select no_plan();
-- Genuine nonempty pre05 authority exists only inside this rollback transaction.
alter table public.party_grid_maps drop constraint if exists party_grid_maps_dm_private;
drop policy if exists "DM reads private Grid Maps" on public.party_grid_maps;
drop policy if exists "Members read revealed or DM private Grid Maps" on public.party_grid_maps;
create policy "Members read revealed or DM private Grid Maps" on public.party_grid_maps for select to authenticated using(public.is_party_dm(party_id) or (visibility='revealed' and public.is_party_member(party_id)));
-- __LEGACY_MAP_COMMAND__
insert into auth.users(id,email,raw_app_meta_data,raw_user_meta_data) values('55000000-0000-4000-8000-000000000011','Ticket05-dm@verification.test','{}','{}'),('55000000-0000-4000-8000-000000000012','Ticket05-player@verification.test','{}','{}');
insert into public.party_members(party_id,user_id,role)values('00000000-0000-4000-8000-000000000001','55000000-0000-4000-8000-000000000011','dungeon-master'),('00000000-0000-4000-8000-000000000001','55000000-0000-4000-8000-000000000012','player');
insert into storage.objects(bucket_id,name,metadata)select 'party-handouts','00000000-0000-4000-8000-000000000001/'||id,'{"size":68,"mimetype":"image/png"}'::jsonb from unnest(array['55000000-0000-4000-8000-000000000003','55000000-0000-4000-8000-000000000004','55000000-0000-4000-8000-000000000005'])id;
set local role authenticated;
set local "request.jwt.claim.sub"='55000000-0000-4000-8000-000000000011';
select public.attach_map_artwork_version('55000000-0000-4000-8000-000000000001',null,0,'55000000-0000-4000-8000-000000000003','Ticket05 historical','{"columns":8,"rows":6,"feetPerSquare":5,"terrain":[],"edges":[]}',jsonb_build_object('x',1,'y',0,'width',6,'height',6,'pixelWidth',8,'pixelHeight',8,'size',68,'mime','image/png','digest',repeat('a',64),'object_id','55000000-0000-4000-8000-000000000003'),jsonb_build_object('x',1,'y',0,'width',6,'height',6,'pixelWidth',8,'pixelHeight',8,'size',68,'mime','image/png','digest',repeat('b',64),'object_id','55000000-0000-4000-8000-000000000005'),'Secret reference and instructions','original');
select public.save_party_grid_map('55000000-0000-4000-8000-000000000001',1,'55000000-0000-4000-8000-000000000004','Ticket05 current','{"columns":8,"rows":6,"feetPerSquare":5,"terrain":[{"x":1,"y":1,"kind":"water"}],"edges":[]}','replace',jsonb_build_object('x',1,'y',0,'width',6,'height',6,'pixelWidth',8,'pixelHeight',8,'size',68,'mime','image/png','digest',repeat('c',64),'object_id','55000000-0000-4000-8000-000000000004'),'replacement');
select public.change_party_grid_map('55000000-0000-4000-8000-000000000001',2,'55000000-0000-4000-8000-000000000006','reveal',null,null,'legacy-reveal');
select public.change_party_grid_map('55000000-0000-4000-8000-000000000001',3,'55000000-0000-4000-8000-000000000007','copy','55000000-0000-4000-8000-000000000002','Ticket05 independent copy','legacy-copy');
reset role;
create temp table before_maps as select to_jsonb(t)-'visibility' data from public.party_grid_maps t;
create temp table before_versions as select to_jsonb(t) data from public.party_map_artwork_versions t;
create temp table before_receipts as select to_jsonb(t) data from public.party_grid_map_requests t;
create temp table before_objects as select to_jsonb(t) data from storage.objects t;
create temp table before_characters as select to_jsonb(t) data from public.character_slots t;
-- __MAP_PRIVACY_MIGRATION__
select is((select count(*) from public.party_grid_maps where visibility<>'private'),0::bigint,'existing revealed maps become private');
select is((select jsonb_agg(to_jsonb(t)-'visibility' order by id) from public.party_grid_maps t),(select jsonb_agg(data order by data->>'id') from before_maps),'documents, geometry, version counters and independent copies preserved');
select is((select jsonb_agg(to_jsonb(t) order by id) from public.party_map_artwork_versions t),(select jsonb_agg(data order by data->>'id') from before_versions),'all immutable versions, references, instructions and job identities preserved');
select is((select jsonb_agg(to_jsonb(t) order by request_id) from public.party_grid_map_requests t),(select jsonb_agg(data order by data->>'request_id') from before_receipts),'historical receipts retained byte-for-byte');
select is((select jsonb_agg(to_jsonb(t) order by id) from storage.objects t),(select jsonb_agg(data order by data->>'id') from before_objects),'artwork storage records preserved');
select is((select jsonb_agg(to_jsonb(t) order by id) from public.character_slots t),(select jsonb_agg(data order by data->>'id') from before_characters),'Character Records preserved');
set local role authenticated;
set local "request.jwt.claim.sub"='55000000-0000-4000-8000-000000000011';
select is((select count(*) from public.party_grid_maps where id::text like '55000000-%'),2::bigint,'DM reads both retained maps');
select throws_ok($$select public.change_party_grid_map('55000000-0000-4000-8000-000000000001',2,'55000000-0000-4000-8000-000000000006','reveal',null,null,'legacy-reveal')$$,'P0001','Invalid Grid Map change','accepted old reveal receipt cannot restore obsolete command');
select throws_ok($$select public.change_party_grid_map('55000000-0000-4000-8000-000000000001',3,'55000000-0000-4000-8000-000000000008','withdraw',null,null,'withdraw')$$,'P0001','Invalid Grid Map change','obsolete withdrawal command denied');
select is(public.change_party_grid_map('55000000-0000-4000-8000-000000000001',3,'55000000-0000-4000-8000-000000000007','copy','55000000-0000-4000-8000-000000000002','Ticket05 independent copy','legacy-copy')->'item'->>'id','55000000-0000-4000-8000-000000000002','old copy receipt still accepted');
select lives_ok($$select public.choose_map_presentation('55000000-0000-4000-8000-000000000004',0,'55000000-0000-4000-8000-000000000009',true)$$,'private map presentation remains authorized');
select is((select visibility from public.party_grid_maps where id='55000000-0000-4000-8000-000000000001'),'private','choosing presentation never reveals map');
set local "request.jwt.claim.sub"='55000000-0000-4000-8000-000000000012';
select is((select count(*) from public.party_grid_maps),0::bigint,'Player cannot list maps even with legacy known ids');
select is((select count(*) from public.party_grid_map_requests),0::bigint,'Player cannot read saved receipts');
select is((select count(*) from public.party_map_artwork_versions),0::bigint,'Player cannot read versions, job identities or references');
select is((select count(*) from public.party_map_presentations),0::bigint,'Player cannot read presentation metadata');
select is((select count(*) from public.party_map_presentation_requests),0::bigint,'Player cannot read presentation receipts');
select is((select count(*) from storage.objects where name like '%/55000000-%'),0::bigint,'Player known current, historical and reference paths denied');
select throws_ok($$select public.read_map_workspace()$$,'42501','Dungeon Master access is required','Player workspace denied');
select throws_ok($$select public.change_party_grid_map('55000000-0000-4000-8000-000000000001',3,'55000000-0000-4000-8000-00000000000a','reveal',null,null,'reveal')$$,'42501','Dungeon Master access is required to change Grid Maps','stale Player command denied');
reset role;
insert into public.party_handouts(id,party_id,title,visibility,mime,size,digest,object_id,version,content_version)values('55000000-0000-4000-8000-000000000015','00000000-0000-4000-8000-000000000001','Ticket05 mixed Handout','revealed','image/png',68,repeat('a',64),'55000000-0000-4000-8000-000000000003',1,1);
set local role authenticated;
set local "request.jwt.claim.sub"='55000000-0000-4000-8000-000000000012';
select is((select count(*) from storage.objects where name like '%/55000000-%'),1::bigint,'explicit mixed-object Handout grant allows only its own bytes');
select is((select count(*) from public.party_handouts where id='55000000-0000-4000-8000-000000000015'),1::bigint,'revealed mixed Handout still lists');
select is((select count(*) from public.party_grid_maps),0::bigint,'mixed Handout never grants map metadata');
set local role anon;
select throws_ok($$select * from public.party_grid_maps$$,'42501',null,'anonymous map metadata denied');
select throws_ok($$select * from public.party_grid_map_requests$$,'42501',null,'anonymous saved receipts denied');
select throws_ok($$select * from public.party_map_artwork_versions$$,'42501',null,'anonymous versions/references denied');
select throws_ok($$select * from public.party_map_presentations$$,'42501',null,'anonymous presentation metadata denied');
select throws_ok($$select * from public.party_map_presentation_requests$$,'42501',null,'anonymous presentation receipts denied');
select is((select count(*) from storage.objects where name like '%/55000000-%'),0::bigint,'anonymous known paths denied even for revealed Handout');
reset role;
select throws_ok($$update public.party_grid_maps set visibility='revealed' where id='55000000-0000-4000-8000-000000000001'$$,'23514',null,'direct stale visibility write denied by invariant');
set local role authenticated;
set local "request.jwt.claim.sub"='55000000-0000-4000-8000-000000000011';
select lives_ok($$select public.change_party_handout('55000000-0000-4000-8000-000000000015',1,'55000000-0000-4000-8000-000000000016','withdraw',null,null,'withdraw')$$,'Handout withdrawal remains available');
set local "request.jwt.claim.sub"='55000000-0000-4000-8000-000000000012';
select is((select count(*) from storage.objects where name like '%/55000000-%'),0::bigint,'withdrawn mixed Handout removes separate byte access');
select * from finish();
rollback;
