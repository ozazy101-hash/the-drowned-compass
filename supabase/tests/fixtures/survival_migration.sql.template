begin;
create extension if not exists pgtap with schema extensions;
select no_plan();
create temporary table before_survival_migration as select to_jsonb(s) data from public.character_slots s order by position;
-- __SURVIVAL_MIGRATION__
select results_eq($$select to_jsonb(s) from public.character_slots s order by position$$,
  $$select data from before_survival_migration$$, 'migration preserves all six slots, claims, data and versions');
insert into auth.users (
  instance_id, id, aud, role, email, encrypted_password, email_confirmed_at,
  raw_app_meta_data, raw_user_meta_data, created_at, updated_at
) values
  (
    '00000000-0000-0000-0000-000000000000',
    '30000000-0000-4000-8000-000000000001',
    'authenticated', 'authenticated', 'players@drowned-compass.test', '', now(),
    '{}', '{}', now(), now()
  ),
  (
    '00000000-0000-0000-0000-000000000000',
    '30000000-0000-4000-8000-000000000002',
    'authenticated', 'authenticated', 'dm@drowned-compass.test', '', now(),
    '{}', '{}', now(), now()
  ),
  (
    '00000000-0000-0000-0000-000000000000',
    '30000000-0000-4000-8000-000000000003',
    'authenticated', 'authenticated', 'overview-outsider@drowned-compass.test', '', now(),
    '{}', '{}', now(), now()
  );

set local role authenticated;
set local "request.jwt.claim.sub" = '30000000-0000-4000-8000-000000000001';

select results_eq(
  $$
    update public.character_slots
    set claimed_at = now(),
      claimed_by = '30000000-0000-4000-8000-000000000001',
      player_name = 'Mara', character_name = 'Neris Vale',
      primary_class = 'Rogue', subclass = 'Thief', species = 'Human',
      background = 'Sailor', level = 3,
      strength = 9, dexterity = 17, constitution = 13,
      intelligence = 14, wisdom = 12, charisma = 11,
      version = 1, updated_at = now()
    where position = 1
    returning character_name
  $$,
  array['Neris Vale'],
  'Player can prepare a complete claimed Character Record'
);

select ok(not has_table_privilege('authenticated','public.character_survival','UPDATE'), 'direct writes denied');
select ok(not has_table_privilege('authenticated','public.character_survival','INSERT'), 'direct inserts denied');
select ok(not has_table_privilege('authenticated','public.character_survival','DELETE'), 'direct deletes denied');
select ok(not has_function_privilege('anon','public.update_character_survival(uuid,jsonb,bigint,bigint)','EXECUTE'), 'anon RPC denied');
select set_config('test.survival_slot',(select id::text from public.character_slots where position=1),true);
select ok(public.update_character_survival(current_setting('test.survival_slot')::uuid,'{"kind":"correct","field":"current","value":20}',0,0),'current correction accepted');
select ok(public.update_character_survival(current_setting('test.survival_slot')::uuid,'{"kind":"correct","field":"temporary","value":5}',1,0),'temporary correction accepted');
select ok(not public.update_character_survival(current_setting('test.survival_slot')::uuid,'{"kind":"damage","amount":99}',1,0),'stale action rejected');
select ok(public.update_character_survival(current_setting('test.survival_slot')::uuid,'{"kind":"damage","amount":12}',2,0),'damage accepted');
select is((select state->>'current' from public.character_survival),'13','damage consumes buffer before current');
select is((select state->>'temporary' from public.character_survival),'0','temporary depleted');
set local "request.jwt.claim.sub" = '30000000-0000-4000-8000-000000000002';
select ok(public.update_character_survival(current_setting('test.survival_slot')::uuid,'{"kind":"track","field":"inspiration","value":true}',3,0),'DM survival write accepted');
select ok(public.update_character_survival(current_setting('test.survival_slot')::uuid,'{"kind":"undo"}',4,0),'shared undo accepted');
select is((select state->>'current' from public.character_survival),'20','undo restores current');
select is((select state->>'temporary' from public.character_survival),'5','undo restores buffer');
select is((select state->>'inspiration' from public.character_survival),'true','undo preserves inspiration');
select ok(not public.update_character_survival(current_setting('test.survival_slot')::uuid,'{"kind":"undo"}',5,0),'undo cannot repeat');
select ok(public.update_character_survival(current_setting('test.survival_slot')::uuid,'{"kind":"heal","amount":99}',5,0),'heal accepted');
select is((select state->>'current' from public.character_survival),'1','heal capped to maximum');
select is((select state->>'temporary' from public.character_survival),'5','healing leaves buffer');
select throws_ok($$select public.update_character_survival(current_setting('test.survival_slot')::uuid,'{"kind":"damage","amount":1.5}',6,0)$$,'23514',null,'fraction rejected');
select throws_ok($$select public.update_character_survival(current_setting('test.survival_slot')::uuid,'{"kind":"track","field":"failures","value":4}',6,0)$$,'23514',null,'death saves bounded');
select throws_ok($$select public.update_character_survival(current_setting('test.survival_slot')::uuid,'{"kind":"bad"}',6,0)$$,'23514',null,'unknown command rejected');
select ok(public.update_character_survival(current_setting('test.survival_slot')::uuid,'{"kind":"damage","amount":99}',6,0),'overflow accepted');
select is((select state->>'current' from public.character_survival),'0','overflow floors at zero');
update public.character_slots set overview_field_versions='{"maxHitPoints":1}' where position=1;
select ok(not public.update_character_survival(current_setting('test.survival_slot')::uuid,'{"kind":"undo"}',7,1),'maximum change invalidates undo');
select ok(not public.update_character_survival(current_setting('test.survival_slot')::uuid,'{"kind":"heal","amount":1}',7,0),'stale maximum rejected');
select results_eq($$select character_name,armor_class from public.character_slots where position=1$$,$$values ('Neris Vale'::text,10)$$,'survival writes preserve unrelated Overview values');
select ok(not public.update_character_survival((select id from public.character_slots where position=2),'{"kind":"correct","field":"current","value":10}',0,0),'unclaimed slot cannot gain survival state');
select ok(exists(select 1 from pg_publication_tables where pubname='supabase_realtime' and tablename='character_survival'),'survival published');
set local "request.jwt.claim.sub" = '30000000-0000-4000-8000-000000000003';
select is((select count(*)::integer from public.character_survival),0,'outsider cannot read');
select ok(not public.update_character_survival(current_setting('test.survival_slot')::uuid,'{"kind":"heal","amount":1}',7,1),'outsider cannot write');
set local role anon;
select throws_ok($$select * from public.character_survival$$,'42501',null,'anon cannot read');
select throws_ok($$select public.update_character_survival(current_setting('test.survival_slot')::uuid,'{"kind":"undo"}',7,1)$$,'42501',null,'anon cannot write');
reset role;
-- __HEALTH_MIGRATION__
set local role authenticated;
set local "request.jwt.claim.sub" = '30000000-0000-4000-8000-000000000001';
select ok(public.update_character_survival(current_setting('test.survival_slot')::uuid,'{"kind":"correct","field":"temporary","value":8}',7,1),'legacy temporary values remain compatible');
select ok(public.update_character_survival(current_setting('test.survival_slot')::uuid,'{"kind":"set-current","value":1}',8,1),'bounded setup accepted');
select ok(public.update_character_survival(current_setting('test.survival_slot')::uuid,'{"kind":"subtract","amount":1}',9,1),'neutral subtraction accepted');
select is((select state->>'current' from public.character_survival),'0','neutral subtraction ignores saved temporary');
select is((select state->>'temporary' from public.character_survival),'8','saved temporary is preserved without absorption');
select ok(public.update_character_survival(current_setting('test.survival_slot')::uuid,'{"kind":"add","amount":99}',10,1),'neutral addition accepted');
select is((select state->>'current' from public.character_survival),'1','neutral addition capped');
select ok(not public.update_character_survival(current_setting('test.survival_slot')::uuid,'{"kind":"subtract","amount":1}',10,1),'neutral stale write rejected');
select throws_ok($$select public.update_character_survival(current_setting('test.survival_slot')::uuid,'{"kind":"set-current","value":2}',11,1)$$,'23514',null,'correction bounded');
select throws_ok($$select public.update_character_survival(current_setting('test.survival_slot')::uuid,'{"kind":"subtract","amount":1.5}',11,1)$$,'23514',null,'neutral fraction rejected');
select * from finish();
rollback;
