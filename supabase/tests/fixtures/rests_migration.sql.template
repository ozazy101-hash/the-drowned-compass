begin;
create extension if not exists pgtap with schema extensions;
select no_plan();
create temporary table before_rests_migration as select to_jsonb(s) data from public.character_slots s order by position;
-- __SURVIVAL_MIGRATION__
-- __HEALTH_MIGRATION__
-- __LIMITED_RESOURCES_MIGRATION__
-- __MAGIC_MIGRATION__
-- __RESTS_MIGRATION__
select results_eq($$select to_jsonb(s) from public.character_slots s order by position$$,
  $$select data from before_rests_migration$$, 'migration preserves all six slots, claims, data and versions');
insert into auth.users (
  instance_id, id, aud, role, email, encrypted_password, email_confirmed_at,
  raw_app_meta_data, raw_user_meta_data, created_at, updated_at
) values
  (
    '00000000-0000-0000-0000-000000000000',
    '30000000-0000-4000-8000-000000000001',
    'authenticated', 'authenticated', 'players@drowned-compass.test', '', now(),
    '{}', '{}', now(), now()
  ),
  (
    '00000000-0000-0000-0000-000000000000',
    '30000000-0000-4000-8000-000000000002',
    'authenticated', 'authenticated', 'dm@drowned-compass.test', '', now(),
    '{}', '{}', now(), now()
  ),
  (
    '00000000-0000-0000-0000-000000000000',
    '30000000-0000-4000-8000-000000000003',
    'authenticated', 'authenticated', 'overview-outsider@drowned-compass.test', '', now(),
    '{}', '{}', now(), now()
  );

set local role authenticated;
set local "request.jwt.claim.sub" = '30000000-0000-4000-8000-000000000001';

select results_eq(
  $$
    update public.character_slots
    set claimed_at = now(),
      claimed_by = '30000000-0000-4000-8000-000000000001',
      player_name = 'Mara', character_name = 'Neris Vale',
      primary_class = 'Rogue', subclass = 'Thief', species = 'Human',
      background = 'Sailor', level = 3,
      strength = 9, dexterity = 17, constitution = 13,
      intelligence = 14, wisdom = 12, charisma = 11,
      version = 1, updated_at = now()
    where position = 1
    returning character_name
  $$,
  array['Neris Vale'],
  'Player can prepare a complete claimed Character Record'
);


reset role;
select set_config('test.rest_slot',(select id::text from public.character_slots where position=1),true);
update public.character_slots set max_hit_points=20,overview_field_versions='{"maxHitPoints":2,"armorClass":5}' where position=1;
insert into public.character_survival(slot_id,state) values(current_setting('test.rest_slot')::uuid,'{"current":3,"temporary":7,"version":3,"successes":2,"failures":1,"unconscious":true,"inspiration":true,"undo":null}');
insert into public.limited_resources(id,slot_id,name,current,maximum,recovery,position,important,version)
values ('11111111-1111-4111-8111-111111111110',current_setting('test.rest_slot')::uuid,'Short',1,3,'Short Rest',0,true,2),
('11111111-1111-4111-8111-111111111111',current_setting('test.rest_slot')::uuid,'Long',1,3,'Long Rest',1,false,2),
('11111111-1111-4111-8111-111111111112',current_setting('test.rest_slot')::uuid,'Dawn',1,3,'Dawn',2,false,2),
('11111111-1111-4111-8111-111111111113',current_setting('test.rest_slot')::uuid,'Manual',1,3,'Manual',3,false,2);
insert into public.character_magic(slot_id,id,kind,state,version) values
(current_setting('test.rest_slot')::uuid,'slots.1','slots','{"level":1,"maximum":3,"remaining":1}',4),
(current_setting('test.rest_slot')::uuid,'slots.2','slots','{"level":2,"maximum":0,"remaining":0}',1),
(current_setting('test.rest_slot')::uuid,'srd-5.2.1:acid-splash','spell','{"catalogId":"srd-5.2.1:acid-splash","name":"","level":0,"availability":"Known","source":"","notes":"Keep notes","deleted":true}',2);
select set_config('test.rest_command','{"operationId":"22222222-2222-4222-8222-222222222222","rest":"Long Rest","changes":[{"kind":"resource","id":"11111111-1111-4111-8111-111111111110","expectedVersion":2},{"kind":"resource","id":"11111111-1111-4111-8111-111111111111","expectedVersion":2},{"kind":"slots","level":1,"expectedVersion":4},{"kind":"health","field":"current","expectedVersion":3,"maximumVersion":2},{"kind":"health","field":"successes","expectedVersion":3},{"kind":"health","field":"failures","expectedVersion":3}]}',true);
set local role authenticated;
set local "request.jwt.claim.sub" = '30000000-0000-4000-8000-000000000001';
select ok(has_function_privilege('authenticated','public.resolve_character_rest(uuid,jsonb)','EXECUTE'),'authenticated can execute rest RPC');
select ok(not has_function_privilege('anon','public.resolve_character_rest(uuid,jsonb)','EXECUTE'),'anon denied rest RPC');
select ok(not has_table_privilege('authenticated','public.character_rest_receipts','INSERT'),'receipt inserts are RPC-only');
select ok(not has_table_privilege('authenticated','public.character_rest_receipts','UPDATE'),'receipt updates are RPC-only');
select ok(not has_table_privilege('authenticated','public.character_rest_receipts','DELETE'),'receipt deletions are denied');
select is(public.resolve_character_rest((select id from public.character_slots where position=2),current_setting('test.rest_command')::jsonb),false,'unclaimed slot denied');
select is(public.resolve_character_rest(current_setting('test.rest_slot')::uuid,jsonb_set(current_setting('test.rest_command')::jsonb,'{changes,2,expectedVersion}','3')),false,'stale selected slots reject complete transaction');
select is((select current from public.limited_resources where name='Short'),1,'failed transaction did not change earlier resource');
select is((select state->>'current' from public.character_survival),'3','failed transaction did not change HP');
select is((select count(*)::int from public.character_rest_receipts),0,'conflict creates no receipt');
select is(public.resolve_character_rest(current_setting('test.rest_slot')::uuid,jsonb_set(current_setting('test.rest_command')::jsonb,'{changes,3,maximumVersion}','1')),false,'stale maximum rejects selected HP');
select is(public.resolve_character_rest(current_setting('test.rest_slot')::uuid,jsonb_set(current_setting('test.rest_command')::jsonb,'{changes,4,expectedVersion}','2')),false,'stale survival rejects selected death saves');
select throws_ok($$select public.resolve_character_rest(current_setting('test.rest_slot')::uuid,jsonb_set(current_setting('test.rest_command')::jsonb,'{rest}','"Short Rest"'))$$,'23514',null,'Short Rest cannot clear health or slots');
select throws_ok($$select public.resolve_character_rest(current_setting('test.rest_slot')::uuid,'null'::jsonb)$$,'23514',null,'invalid shape 0 rejected');
select throws_ok($$select public.resolve_character_rest(current_setting('test.rest_slot')::uuid,'{}'::jsonb)$$,'23514',null,'invalid shape 1 rejected');
select throws_ok($$select public.resolve_character_rest(current_setting('test.rest_slot')::uuid,'{"rest":"Long Rest","operationId":"bad","changes":[]}'::jsonb)$$,'23514',null,'invalid shape 2 rejected');
select throws_ok($$select public.resolve_character_rest(current_setting('test.rest_slot')::uuid,'{"operationId":"33333333-3333-4333-8333-333333333333","rest":"Long Rest","changes":[]}'::jsonb)$$,'23514',null,'invalid shape 3 rejected');
select throws_ok($$select public.resolve_character_rest(current_setting('test.rest_slot')::uuid,'{"operationId":"33333333-3333-4333-8333-333333333333","rest":"Long Rest","changes":[{"kind":"health","field":"temporary","expectedVersion":3}]}'::jsonb)$$,'23514',null,'invalid shape 4 rejected');
select throws_ok($$select public.resolve_character_rest(current_setting('test.rest_slot')::uuid,jsonb_set(current_setting('test.rest_command')::jsonb,'{changes,0,expectedVersion}','2147483647'))$$,'23514',null,'resource version overflow rejected');
select throws_ok($$select public.resolve_character_rest(current_setting('test.rest_slot')::uuid,jsonb_set(current_setting('test.rest_command')::jsonb,'{changes,2,expectedVersion}','9007199254740991'))$$,'23514',null,'Magic unsafe integer rejected');
select throws_ok($$select public.resolve_character_rest(current_setting('test.rest_slot')::uuid,jsonb_set(current_setting('test.rest_command')::jsonb,'{changes,3,maximumVersion}','-1'))$$,'23514',null,'negative maximum version rejected');
select throws_ok($$select public.resolve_character_rest(current_setting('test.rest_slot')::uuid,jsonb_set(current_setting('test.rest_command')::jsonb,'{changes,4,expectedVersion}','1.5'))$$,'23514',null,'fractional version rejected');
select throws_ok($$select public.resolve_character_rest(current_setting('test.rest_slot')::uuid,jsonb_set(current_setting('test.rest_command')::jsonb,'{changes}',jsonb_build_array(current_setting('test.rest_command')::jsonb->'changes'->0,current_setting('test.rest_command')::jsonb->'changes'->0)))$$,'23514',null,'duplicate selected identities rejected');
select is(public.resolve_character_rest(current_setting('test.rest_slot')::uuid,'{"operationId":"33333333-3333-4333-8333-333333333333","rest":"Long Rest","changes":[{"kind":"resource","id":"11111111-1111-4111-8111-111111111112","expectedVersion":2}]}'),false,'Dawn cannot recover on rest');
select is(public.resolve_character_rest(current_setting('test.rest_slot')::uuid,'{"operationId":"33333333-3333-4333-8333-333333333333","rest":"Long Rest","changes":[{"kind":"resource","id":"11111111-1111-4111-8111-111111111113","expectedVersion":2}]}'),false,'Manual cannot recover on rest');
select is(public.resolve_character_rest(current_setting('test.rest_slot')::uuid,'{"operationId":"33333333-3333-4333-8333-333333333333","rest":"Short Rest","changes":[{"kind":"resource","id":"11111111-1111-4111-8111-111111111111","expectedVersion":2}]}'),false,'Short Rest cannot recover Long Rest resource');
select is(public.resolve_character_rest(current_setting('test.rest_slot')::uuid,'{"operationId":"33333333-3333-4333-8333-333333333333","rest":"Long Rest","changes":[{"kind":"slots","level":2,"expectedVersion":1}]}'),false,'zero/full slot maximum causes no write');
reset role;
update public.limited_resources set deleted=true,important=false,version=3 where name='Short';
set local role authenticated;
select is(public.resolve_character_rest(current_setting('test.rest_slot')::uuid,current_setting('test.rest_command')::jsonb),false,'selected tombstone rejects complete rest');
select is((select state->>'remaining' from public.character_magic where id='slots.1'),'1','removed resource conflict leaves slots intact');
reset role;
update public.limited_resources set deleted=false,important=true,version=2 where name='Short';
update public.character_slots set character_name='New Neris' where position=1;
set local role authenticated;
select is(public.resolve_character_rest(current_setting('test.rest_slot')::uuid,current_setting('test.rest_command')::jsonb),true,'all selected recoveries commit as one operation');
select is((select state->>'current' from public.character_survival),'20','HP restored to saved maximum');
select is((select state->>'temporary' from public.character_survival),'7','legacy temporary HP preserved');
select is((select state->>'version' from public.character_survival),'4','Survival increments once for three fields');
select is((select state->>'successes' from public.character_survival),'0','death successes cleared');
select is((select state->>'failures' from public.character_survival),'0','death failures cleared');
select is((select state->>'inspiration' from public.character_survival),'true','inspiration preserved');
select is((select state->>'unconscious' from public.character_survival),'true','manual unconscious preserved');
select is((select character_name from public.character_slots where position=1),'New Neris','unrelated Character field preserved');
select is((select current from public.limited_resources where name='Short'),3,'Short resource restored');
select is((select current from public.limited_resources where name='Long'),3,'Long resource restored');
select is((select current from public.limited_resources where name='Dawn'),1,'Dawn preserved');
select is((select current from public.limited_resources where name='Manual'),1,'Manual preserved');
select is((select version from public.character_magic where id='slots.1'),5::bigint,'selected slots increment once');
select is((select state->>'remaining' from public.character_magic where id='slots.1'),'3','configured slot maximum restored');
select is((select state->>'deleted' from public.character_magic where id='srd-5.2.1:acid-splash'),'true','Character Spell tombstone preserved');
select is((select count(*)::int from public.character_rest_receipts),1,'member can read latest receipt');
select is(public.update_character_magic(current_setting('test.rest_slot')::uuid,'{"kind":"slots","level":1,"action":"spend","expectedVersion":5}'),true,'independent action after rest accepted');
select is(public.resolve_character_rest(current_setting('test.rest_slot')::uuid,current_setting('test.rest_command')::jsonb),true,'lost-ack retry acknowledges accepted receipt');
select is((select state->>'remaining' from public.character_magic where id='slots.1'),'2','receipt retry does not repeat recovery over later spend');
select is((select version from public.character_magic where id='slots.1'),6::bigint,'receipt retry adds no duplicate version');
select throws_ok($$select public.resolve_character_rest(current_setting('test.rest_slot')::uuid,jsonb_set(current_setting('test.rest_command')::jsonb,'{changes}',jsonb_build_array(current_setting('test.rest_command')::jsonb->'changes'->0)))$$,'23514',null,'same operation different selection rejected');
select is(public.resolve_character_rest(current_setting('test.rest_slot')::uuid,'{"operationId":"33333333-3333-4333-8333-333333333333","rest":"Long Rest","changes":[{"kind":"slots","level":1,"expectedVersion":6}]}'),true,'excluded health and resource changes need no CAS');
select is(public.resolve_character_rest(current_setting('test.rest_slot')::uuid,current_setting('test.rest_command')::jsonb),false,'superseded receipt old preview safely conflicts');
reset role;
update public.character_survival set state=state || '{"current":null,"successes":1,"failures":2,"version":5}'::jsonb;
update public.character_slots set max_hit_points=1,overview_field_versions='{"maxHitPoints":3}' where position=1;
set local role authenticated;
select is(public.resolve_character_rest(current_setting('test.rest_slot')::uuid,'{"operationId":"44444444-4444-4444-8444-444444444444","rest":"Long Rest","changes":[{"kind":"health","field":"successes","expectedVersion":5}]}'),true,'successes can be selected while excluding HP and failures');
select is((select state->>'failures' from public.character_survival),'2','excluded failures preserved');
select is((select state->'current' from public.character_survival),'null'::jsonb,'excluded unknown HP preserved');
select is(public.resolve_character_rest(current_setting('test.rest_slot')::uuid,'{"operationId":"55555555-5555-4555-8555-555555555555","rest":"Long Rest","changes":[{"kind":"health","field":"current","expectedVersion":6,"maximumVersion":3}]}'),true,'unknown HP can recover to minimum saved maximum');
select is((select state->>'current' from public.character_survival),'1','unknown explicitly becomes minimum maximum');
set local "request.jwt.claim.sub" = '30000000-0000-4000-8000-000000000002';
select is(public.resolve_character_rest(current_setting('test.rest_slot')::uuid,'{"operationId":"66666666-6666-4666-8666-666666666666","rest":"Long Rest","changes":[{"kind":"health","field":"failures","expectedVersion":7}]}'),true,'DM can resolve rest for shared Party');
set local "request.jwt.claim.sub" = '30000000-0000-4000-8000-000000000003';
select is((select count(*)::int from public.character_rest_receipts),0,'outsider cannot read receipts');
select is(public.resolve_character_rest(current_setting('test.rest_slot')::uuid,current_setting('test.rest_command')::jsonb),false,'outsider cannot resolve or replay member rest');
set local role anon;
reset "request.jwt.claim.sub";
select throws_ok($$select * from public.character_rest_receipts$$,'42501',null,'anonymous cannot read receipt');
select throws_ok($$select public.resolve_character_rest(current_setting('test.rest_slot')::uuid,'{}')$$,'42501',null,'anonymous cannot resolve rest');
select * from finish();
rollback;
