begin;
create extension if not exists pgtap with schema extensions;
select no_plan();
create temporary table before_magic_migration as select to_jsonb(s) data from public.character_slots s order by position;
-- __MAGIC_MIGRATION__
select results_eq($$select to_jsonb(s) from public.character_slots s order by position$$,
  $$select data from before_magic_migration$$, 'migration preserves all six slots, claims, data and versions');
insert into auth.users (
  instance_id, id, aud, role, email, encrypted_password, email_confirmed_at,
  raw_app_meta_data, raw_user_meta_data, created_at, updated_at
) values
  (
    '00000000-0000-0000-0000-000000000000',
    '30000000-0000-4000-8000-000000000001',
    'authenticated', 'authenticated', 'players@drowned-compass.test', '', now(),
    '{}', '{}', now(), now()
  ),
  (
    '00000000-0000-0000-0000-000000000000',
    '30000000-0000-4000-8000-000000000002',
    'authenticated', 'authenticated', 'dm@drowned-compass.test', '', now(),
    '{}', '{}', now(), now()
  ),
  (
    '00000000-0000-0000-0000-000000000000',
    '30000000-0000-4000-8000-000000000003',
    'authenticated', 'authenticated', 'overview-outsider@drowned-compass.test', '', now(),
    '{}', '{}', now(), now()
  );

set local role authenticated;
set local "request.jwt.claim.sub" = '30000000-0000-4000-8000-000000000001';

select results_eq(
  $$
    update public.character_slots
    set claimed_at = now(),
      claimed_by = '30000000-0000-4000-8000-000000000001',
      player_name = 'Mara', character_name = 'Neris Vale',
      primary_class = 'Rogue', subclass = 'Thief', species = 'Human',
      background = 'Sailor', level = 3,
      strength = 9, dexterity = 17, constitution = 13,
      intelligence = 14, wisdom = 12, charisma = 11,
      version = 1, updated_at = now()
    where position = 1
    returning character_name
  $$,
  array['Neris Vale'],
  'Player can prepare a complete claimed Character Record'
);

select ok(has_function_privilege('authenticated','public.update_character_magic(uuid,jsonb)','EXECUTE'), 'member can execute Magic RPC');
select ok(not has_function_privilege('anon','public.update_character_magic(uuid,jsonb)','EXECUTE'), 'anonymous denied Magic RPC');
select ok(not has_table_privilege('authenticated','public.character_magic','INSERT'), 'direct inserts denied');
select ok(not has_table_privilege('authenticated','public.character_magic','UPDATE'), 'direct updates denied');
select ok(not has_table_privilege('authenticated','public.character_magic','DELETE'), 'direct deletes denied');
select is(public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"spell","spell":{"id":"srd-5.2.1:acid-splash","catalogId":"srd-5.2.1:acid-splash","name":"","level":0,"availability":"Known","source":"","notes":"","deleted":false},"expectedVersion":0}'::jsonb),true,'catalog association added');
select is(public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"spell","spell":{"id":"srd-5.2.1:acid-splash","catalogId":"srd-5.2.1:acid-splash","name":"","level":0,"availability":"Known","source":"","notes":"","deleted":false},"expectedVersion":0}'::jsonb),false,'duplicate initial add conflicts');
select is(public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"spell","spell":{"id":"srd-5.2.1:acid-splash","catalogId":"srd-5.2.1:acid-splash","name":"","level":0,"availability":"Known","source":"","notes":"","deleted":true},"expectedVersion":0}'::jsonb),false,'stale removal conflicts');
select is(public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"spell","spell":{"id":"srd-5.2.1:acid-splash","catalogId":"srd-5.2.1:acid-splash","name":"","level":0,"availability":"Known","source":"","notes":"","deleted":true},"expectedVersion":1}'::jsonb),true,'remove keeps tombstone');
select is(public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"spell","spell":{"id":"srd-5.2.1:acid-splash","catalogId":"srd-5.2.1:acid-splash","name":"","level":0,"availability":"Known","source":"","notes":"","deleted":false},"expectedVersion":0}'::jsonb),false,'stale readd conflicts');
select is(public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"spell","spell":{"id":"srd-5.2.1:acid-splash","catalogId":"srd-5.2.1:acid-splash","name":"","level":0,"availability":"Known","source":"","notes":"","deleted":false},"expectedVersion":2}'::jsonb),true,'versioned readd succeeds');
select is(public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"spell","spell":{"id":"custom.11111111-1111-4111-8111-111111111111","catalogId":null,"name":"Sea Lantern","level":2,"availability":"Known","source":"","notes":"","deleted":false},"expectedVersion":0}'::jsonb),true,'Character scoped custom added');
select is(public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"spell","spell":{"id":"custom.11111111-1111-4111-8111-111111111111","catalogId":null,"name":"Sea Lantern II","level":2,"availability":"Known","source":"","notes":"Use at dusk","deleted":false},"expectedVersion":1}'::jsonb),true,'custom edit accepted');
set local "request.jwt.claim.sub" = '30000000-0000-4000-8000-000000000002';
select is(public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"spell","spell":{"id":"custom.11111111-1111-4111-8111-111111111111","catalogId":null,"name":"Sea Lantern","level":2,"availability":"Feature granted","source":"Moon gift","notes":"","deleted":false},"expectedVersion":2}'::jsonb),true,'DM edits granted source independently');
select is(public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"slots","level":1,"action":"configure","maximum":3,"remaining":3,"expectedVersion":0}'::jsonb),true,'manually configure level one');
select is(public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"slots","level":2,"action":"configure","maximum":2,"remaining":1,"expectedVersion":0}'::jsonb),true,'level two independent');
select is(public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"slots","level":1,"action":"spend","expectedVersion":1}'::jsonb),true,'spend bounded slot');
select is(public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"slots","level":1,"action":"spend","expectedVersion":1}'::jsonb),false,'stale delta rejected');
select is(public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"slots","level":1,"action":"restore","expectedVersion":2}'::jsonb),true,'restore bounded slot');
select throws_ok($$select public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"slots","level":1,"action":"restore","expectedVersion":3}'::jsonb)$$,'23514',null,'restore past max rejected');
select is(public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"slots","level":1,"action":"configure","maximum":1,"remaining":0,"expectedVersion":3}'::jsonb),true,'manual remaining correction');
select throws_ok($$select public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"slots","level":1,"action":"spend","expectedVersion":4}'::jsonb)$$,'23514',null,'spend past zero rejected');
select is(public.update_character_magic((select id from public.character_slots where position=2),'{"kind":"spell","spell":{"id":"srd-5.2.1:acid-splash","catalogId":"srd-5.2.1:acid-splash","name":"","level":0,"availability":"Known","source":"","notes":"","deleted":false},"expectedVersion":0}'::jsonb),false,'unclaimed slot denied');
select throws_ok($$select public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"spell","spell":{"id":"srd-5.2.1:fake","catalogId":"srd-5.2.1:fake","name":"","level":0,"availability":"Known","source":"","notes":"","deleted":false},"expectedVersion":3}'::jsonb)$$,'23514',null,'unknown catalog rejected');
select throws_ok($$select public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"spell","spell":{"id":"srd-5.2.1:acid-splash","catalogId":"srd-5.2.1:acid-splash","name":"copied text","level":0,"availability":"Known","source":"","notes":"","deleted":false},"expectedVersion":3}'::jsonb)$$,'23514',null,'catalog name copy rejected');
select throws_ok($$select public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"spell","spell":{"id":"custom.11111111-1111-4111-8111-111111111111","catalogId":null,"name":"Sea Lantern","level":2,"availability":"Item granted","source":"","notes":"","deleted":false},"expectedVersion":3}'::jsonb)$$,'23514',null,'grant requires source');
select throws_ok($$select public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"spell","spell":{"id":"custom.11111111-1111-4111-8111-111111111111","catalogId":null,"name":" ","level":2,"availability":"Known","source":"","notes":"","deleted":false},"expectedVersion":3}'::jsonb)$$,'23514',null,'blank custom rejected');
select throws_ok($$select public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"spell","spell":{"id":"custom.11111111-1111-4111-8111-111111111111","catalogId":null,"name":"Sea Lantern","level":10,"availability":"Known","source":"","notes":"","deleted":false},"expectedVersion":3}'::jsonb)$$,'23514',null,'invalid custom level rejected');
select throws_ok($$select public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"spell","spell":{"id":"custom.11111111-1111-4111-8111-111111111111","catalogId":null,"name":"Sea Lantern","level":2,"availability":"Known","source":"","notes":"","deleted":false,"description":"proprietary copy"},"expectedVersion":3}'::jsonb)$$,'23514',null,'unexpected rules field rejected');
select throws_ok($$select public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"spell","spell":{"id":"custom.11111111-1111-4111-8111-111111111111","catalogId":null,"name":"Sea Lantern","level":2,"availability":"Known","source":"","notes":"","deleted":false},"expectedVersion":3}'::jsonb)$$,'23514',null,'oversized notes rejected');
select throws_ok($$select public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"slots","level":0,"action":"configure","maximum":1,"remaining":0,"expectedVersion":0}'::jsonb)$$,'23514',null,'invalid slot bounds or version rejected');
select throws_ok($$select public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"slots","level":3,"action":"configure","maximum":1,"remaining":2,"expectedVersion":0}'::jsonb)$$,'23514',null,'invalid slot bounds or version rejected');
select throws_ok($$select public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"slots","level":3,"action":"configure","maximum":1.5,"remaining":1,"expectedVersion":0}'::jsonb)$$,'23514',null,'invalid slot bounds or version rejected');
select throws_ok($$select public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"slots","level":3,"action":"configure","maximum":100,"remaining":1,"expectedVersion":0}'::jsonb)$$,'23514',null,'invalid slot bounds or version rejected');
select throws_ok($$select public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"slots","level":3,"action":"spend","expectedVersion":-1}'::jsonb)$$,'23514',null,'invalid slot bounds or version rejected');
select throws_ok($$select public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"slots","level":3,"action":"spend","expectedVersion":1.5}'::jsonb)$$,'23514',null,'invalid slot bounds or version rejected');
select throws_ok($$select public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"slots","level":3,"action":"spend","expectedVersion":9007199254740991}'::jsonb)$$,'23514',null,'invalid slot bounds or version rejected');
select throws_ok($$select public.update_character_magic((select id from public.character_slots where position=1),' {"kind":"spell","expectedVersion":3,"spell":{"id":"custom.11111111-1111-4111-8111-111111111111","catalogId":null,"name":123,"level":2,"availability":"Known","source":"","notes":"","deleted":false}}'::jsonb)$$,'23514',null,'numeric name rejected before trimming');
select throws_ok($$select public.update_character_magic((select id from public.character_slots where position=1),' {"kind":"spell","expectedVersion":3,"spell":{"id":"custom.11111111-1111-4111-8111-111111111111","catalogId":null,"name":"Sea Lantern","level":2,"availability":"Known","source":true,"notes":"","deleted":false}}'::jsonb)$$,'23514',null,'boolean source rejected before trimming');
select throws_ok($$select public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"spell","spell":{"id":"custom.11111111-1111-4111-8111-111111111111","catalogId":null,"name":" ","level":2,"availability":"Item granted","source":"Moon gift","notes":"","deleted":false},"expectedVersion":3}'::jsonb)$$,'23514',null,'NBSP-only Custom Spell name rejected');
select throws_ok($$select public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"spell","spell":{"id":"custom.11111111-1111-4111-8111-111111111111","catalogId":null,"name":"Sea Lantern","level":2,"availability":"Item granted","source":" ","notes":"","deleted":false},"expectedVersion":3}'::jsonb)$$,'23514',null,'NBSP-only grant source rejected');
select is(public.update_character_magic((select id from public.character_slots where position=1),'{"kind":"spell","spell":{"id":"custom.11111111-1111-4111-8111-111111111111","catalogId":null,"name":" \t\n\r\f\u000b                 　﻿Sea Lantern \t\n\r\f\u000b                 　﻿","level":2,"availability":"Item granted","source":" \t\n\r\f\u000b                 　﻿Moon gift \t\n\r\f\u000b                 　﻿","notes":"","deleted":false},"expectedVersion":3}'::jsonb),true,'all ECMAScript surrounding whitespace trimmed');
select is((select state->>'name' from public.character_magic where id='custom.11111111-1111-4111-8111-111111111111'),'Sea Lantern','Unicode custom name normalization matches JavaScript');
select is((select state->>'source' from public.character_magic where id='custom.11111111-1111-4111-8111-111111111111'),'Moon gift','Unicode source normalization matches JavaScript');
select is(public.update_character_magic((select id from public.character_slots where position=1), jsonb_build_object('kind','spell','expectedVersion',4,'spell',jsonb_build_object('id','custom.11111111-1111-4111-8111-111111111111','catalogId',null,'name',chr(11)||'vRev'||chr(11),'level',2,'availability','Item granted','source',chr(11)||'vWavev'||chr(11),'notes','','deleted',false))),true,'actual vertical tabs trimmed while v edges preserved');
select is((select state->>'name' from public.character_magic where id='custom.11111111-1111-4111-8111-111111111111'),'vRev','leading and trailing lowercase v preserved in name');
select is((select state->>'source' from public.character_magic where id='custom.11111111-1111-4111-8111-111111111111'),'vWavev','leading and trailing lowercase v preserved in source');
select is((select count(*)::int from public.character_magic),4,'distinct spell and slot records preserved');
select is((select state->>'remaining' from public.character_magic where id='slots.2'),'1','independent slot level preserved');
select is((select character_name from public.character_slots where position=1),'Neris Vale','Magic preserves identity');
select is((select overview_field_versions from public.character_slots where position=1),'{}'::jsonb,'Magic preserves overview versions');
select ok(exists(select 1 from pg_publication_tables where pubname='supabase_realtime' and tablename='character_magic'),'Magic publishes realtime');
select set_config('test.magic_slot',(select id::text from public.character_slots where position=1),true);
set local "request.jwt.claim.sub" = '30000000-0000-4000-8000-000000000003';
select is((select count(*)::int from public.character_magic),0,'non-member cannot read Magic');
select is(public.update_character_magic(current_setting('test.magic_slot')::uuid,'{"kind":"slots","level":1,"action":"restore","expectedVersion":4}'::jsonb),false,'non-member cannot write');
set local role anon;
reset "request.jwt.claim.sub";
select throws_ok($$select * from public.character_magic$$,'42501',null,'anonymous cannot read Magic');
select throws_ok($$select public.update_character_magic(current_setting('test.magic_slot')::uuid,'{}')$$,'42501',null,'anonymous cannot write Magic');
select * from finish();
rollback;
