begin;
-- Restore pre05 map sharing only inside this historical rollback rehearsal.
alter table if exists public.party_grid_maps drop constraint if exists party_grid_maps_dm_private;
drop policy if exists "DM reads private Grid Maps" on public.party_grid_maps;
drop policy if exists "Members read revealed or DM private Grid Maps" on public.party_grid_maps;
create policy "Members read revealed or DM private Grid Maps" on public.party_grid_maps for select to authenticated using(public.is_party_dm(party_id) or (visibility='revealed' and public.is_party_member(party_id)));
create extension if not exists pgtap with schema extensions;
select no_plan();
set local storage.allow_delete_query='true';
create temporary table grid_character_snapshot as select to_jsonb(s) data from public.character_slots s order by position;
create temporary table grid_handout_snapshot as select to_jsonb(h) data from public.party_handouts h order by id;
drop table if exists public.party_grid_map_requests,public.party_grid_maps cascade;
drop function if exists public.valid_grid_map_document(jsonb),public.valid_grid_map_background(jsonb,jsonb),public.guard_grid_map_commit(),public.save_party_grid_map(uuid,integer,uuid,text,jsonb,text,jsonb,text) cascade;
-- Recreate the original03 storage policy names after dropping a previously
-- applied06 schema cascades its table-dependent policies in this transaction.
-- Their baseline definitions remain scoped to Handouts until06 replaces them.
drop policy if exists "DM uploads private Handout objects" on storage.objects;
drop policy if exists "DM cleans uncommitted Handout objects" on storage.objects;
drop policy if exists "Members download current revealed or DM private objects" on storage.objects;
create policy "DM uploads private Handout objects" on storage.objects for insert to authenticated with check(bucket_id='party-handouts' and public.can_manage_handout_object(name) and not exists(select 1 from public.party_handouts where party_id::text||'/'||object_id::text=name));
create policy "DM cleans uncommitted Handout objects" on storage.objects for delete to authenticated using(bucket_id='party-handouts' and public.can_manage_handout_object(name) and not exists(select 1 from public.party_handouts where party_id::text||'/'||object_id::text=name));
create policy "Members download current revealed or DM private objects" on storage.objects for select to authenticated using(bucket_id='party-handouts' and (public.can_manage_handout_object(name) or exists(select 1 from public.party_handouts where party_id::text||'/'||object_id::text=name and visibility='revealed' and public.is_party_member(party_id))));
-- __GRID_MAPS_MIGRATION__
create temporary table grid_input(d jsonb,b jsonb);
insert into grid_input values('{"columns":8,"rows":6,"feetPerSquare":5,"terrain":[{"x":1,"y":1,"kind":"water"}],"edges":[{"x":1,"y":1,"direction":"horizontal","kind":"door"}]}',jsonb_build_object('x',0,'y',1,'width',8,'height',4,'pixelWidth',800,'pixelHeight',400,'mime','image/png','size',68,'object_id','60000000-0000-4000-8000-000000000003','digest',repeat('a',64)));
select ok(public.valid_grid_map_document(d),'bounded complete drawing accepted') from grid_input;
select ok(public.valid_grid_map_background(d,b),'proportional logical background accepted') from grid_input;
select ok(public.valid_grid_map_document(d-key)=false,'missing document field rejected: '||key) from grid_input cross join unnest(array['columns','rows','feetPerSquare','terrain','edges']) key;
select ok(public.valid_grid_map_document(jsonb_set(d,array[key],'null'))=false,'null document field rejected: '||key) from grid_input cross join unnest(array['columns','rows','feetPerSquare','terrain','edges']) key;
select ok(public.valid_grid_map_document(jsonb_set(d,array[key],to_jsonb(d->>key)))=false,'string numeric document field rejected: '||key) from grid_input cross join unnest(array['columns','rows','feetPerSquare']) key;
select ok(public.valid_grid_map_background(d,b-key)=false,'missing background field rejected: '||key) from grid_input cross join unnest(array['x','y','width','height','pixelWidth','pixelHeight','mime','size','object_id','digest']) key;
select ok(public.valid_grid_map_background(d,jsonb_set(b,array[key],'null'))=false,'null background field rejected: '||key) from grid_input cross join unnest(array['x','y','width','height','pixelWidth','pixelHeight','mime','size','object_id','digest']) key;
select ok(public.valid_grid_map_background(d,jsonb_set(b,array[key],to_jsonb(b->>key)))=false,'string numeric background field rejected: '||key) from grid_input cross join unnest(array['x','y','width','height','pixelWidth','pixelHeight','size']) key;
select ok(not public.valid_grid_map_document(jsonb_set(d,'{terrain}',(d->'terrain')||(d->'terrain'))),'duplicate cells rejected') from grid_input;
select ok(not public.valid_grid_map_document(jsonb_set(d,'{edges}',(d->'edges')||(d->'edges'))),'duplicate edges rejected') from grid_input;
select ok(not public.valid_grid_map_document(jsonb_set(d,'{terrain,0,x}','8')),'outside cells rejected') from grid_input;
select ok(not public.valid_grid_map_document(jsonb_set(d,'{edges,0,x}','8')),'outside horizontal edges rejected') from grid_input;
select ok(not public.valid_grid_map_document(jsonb_set(d,'{edges,0,direction}','"diagonal"')),'bad orientation rejected') from grid_input;
select ok(not public.valid_grid_map_document(jsonb_set(d,'{terrain,0,x}','"1"')),'string cell coordinate rejected') from grid_input;
select ok(not public.valid_grid_map_document(jsonb_set(d,'{edges,0,y}','"1"')),'string edge coordinate rejected') from grid_input;
select ok(not public.valid_grid_map_background(d,jsonb_set(b,'{width}','7')),'distorted image ratio rejected') from grid_input;
insert into auth.users(id,email,raw_app_meta_data,raw_user_meta_data) values ('60000000-0000-4000-8000-000000000001','grid-dm@verification.test','{}','{}'),('60000000-0000-4000-8000-000000000002','grid-player@verification.test','{}','{}'),('60000000-0000-4000-8000-000000000009','grid-outsider@verification.test','{}','{}');
insert into public.party_members(party_id,user_id,role) values('00000000-0000-4000-8000-000000000001','60000000-0000-4000-8000-000000000001','dungeon-master'),('00000000-0000-4000-8000-000000000001','60000000-0000-4000-8000-000000000002','player');
insert into storage.objects(bucket_id,name,metadata) values('party-handouts','00000000-0000-4000-8000-000000000001/60000000-0000-4000-8000-000000000003','{"size":68,"mimetype":"image/png"}');
grant select on grid_input to authenticated;
set local role authenticated;set local "request.jwt.claim.sub"='60000000-0000-4000-8000-000000000001';
select lives_ok($$select public.save_party_grid_map('60000000-0000-4000-8000-000000000004',0,'60000000-0000-4000-8000-000000000003','Saved map',d,'replace',b,'first') from grid_input$$,'DM commits map and background atomically');
select is((select version from public.party_grid_maps where id='60000000-0000-4000-8000-000000000004'),1,'new map version one');
select is((public.save_party_grid_map('60000000-0000-4000-8000-000000000004',0,'60000000-0000-4000-8000-000000000003','Saved map',d,'replace',b,'first')->'item'->>'version')::integer,1,'same create retry version stable') from grid_input;
select throws_ok($$select public.save_party_grid_map('60000000-0000-4000-8000-000000000004',0,'60000000-0000-4000-8000-000000000003','Changed title',d,'replace',b,'first') from grid_input$$,'P0001','This save request was already used for different content','changed create retry payload denied');
select throws_ok($$select public.save_party_grid_map('60000000-0000-4000-8000-000000000008',0,'60000000-0000-4000-8000-000000000003','Saved map',d,'replace',b,'first') from grid_input$$,'P0001','This save request was already used for different content','request reused for different map denied');
select is((public.save_party_grid_map('60000000-0000-4000-8000-000000000004',0,'60000000-0000-4000-8000-000000000005','Stale',d,'keep',null,'stale')->>'ok')::boolean,false,'stale save reports conflict') from grid_input;
select throws_ok($$select public.save_party_grid_map('60000000-0000-4000-8000-000000000004',1,'60000000-0000-4000-8000-000000000005','Failed',d,'replace',jsonb_set(b,'{object_id}','"60000000-0000-4000-8000-000000000005"'),'failed') from grid_input$$,'P0001','Upload usable image content before saving the Grid Map','missing image rejects save');
select is((select version from public.party_grid_maps where id='60000000-0000-4000-8000-000000000004'),1,'failed save preserves document version');
select is((select background->>'object_id' from public.party_grid_maps where id='60000000-0000-4000-8000-000000000004'),'60000000-0000-4000-8000-000000000003','failed save preserves current image');
select lives_ok($$delete from storage.objects where name='00000000-0000-4000-8000-000000000001/60000000-0000-4000-8000-000000000003'$$,'compensation cannot delete current image');
select is((select count(*) from storage.objects where name='00000000-0000-4000-8000-000000000001/60000000-0000-4000-8000-000000000003'),1::bigint,'current image survives delete');
select throws_ok($$update public.party_grid_maps set title='Bypass'$$,'42501',null,'direct update bypass denied');
set local "request.jwt.claim.sub"='60000000-0000-4000-8000-000000000002';
select is((select count(*) from public.party_grid_maps),0::bigint,'Player cannot enumerate private maps');
select is((select count(*) from public.party_grid_map_requests),0::bigint,'Player cannot enumerate private retry receipts');
select is((select count(*) from storage.objects where name='00000000-0000-4000-8000-000000000001/60000000-0000-4000-8000-000000000003'),0::bigint,'Player denied private background');
select throws_ok($$select public.save_party_grid_map('60000000-0000-4000-8000-000000000004',1,'60000000-0000-4000-8000-000000000006','Player save','{}','remove',null,'player')$$,'42501','Dungeon Master access is required to save Grid Maps','Player save denied');
set local role anon;
select throws_ok($$select * from public.party_grid_maps$$,'42501',null,'anonymous documents denied');
select is((select count(*) from storage.objects where name='00000000-0000-4000-8000-000000000001/60000000-0000-4000-8000-000000000003'),0::bigint,'anonymous images denied');
reset role;
-- Fixture-only revealed state checks access semantics, not Ticket08 workflows.
update public.party_grid_maps set visibility='revealed' where id='60000000-0000-4000-8000-000000000004';
set local role authenticated;set local "request.jwt.claim.sub"='60000000-0000-4000-8000-000000000002';
select is((select count(*) from public.party_grid_maps),1::bigint,'Player reads revealed saved fixture');
select is((select count(*) from storage.objects where name='00000000-0000-4000-8000-000000000001/60000000-0000-4000-8000-000000000003'),1::bigint,'Player reads revealed saved image fixture');
set local "request.jwt.claim.sub"='60000000-0000-4000-8000-000000000009';
select is((select count(*) from public.party_grid_maps),0::bigint,'nonmember denied revealed maps');
select is((select count(*) from storage.objects where name='00000000-0000-4000-8000-000000000001/60000000-0000-4000-8000-000000000003'),0::bigint,'nonmember denied revealed images');
set local "request.jwt.claim.sub"='60000000-0000-4000-8000-000000000001';
select lives_ok($$select public.save_party_grid_map('60000000-0000-4000-8000-000000000004',1,'60000000-0000-4000-8000-000000000006','Removed',d,'remove',null,'remove') from grid_input$$,'removing background accepts coherent map');
select is((public.save_party_grid_map('60000000-0000-4000-8000-000000000004',0,'60000000-0000-4000-8000-000000000003','Saved map',d,'replace',b,'first')->'item'->>'version')::integer,1,'late retry is original receipt, never reverses accepted version') from grid_input;
select is((select version from public.party_grid_maps where id='60000000-0000-4000-8000-000000000004'),2,'late receipt leaves current version intact');
select ok((select background is null from public.party_grid_maps where id='60000000-0000-4000-8000-000000000004'),'removal clears image reference');
reset role;
select results_eq($$select to_jsonb(s) from public.character_slots s order by position$$,$$select data from grid_character_snapshot$$,'map schema and commands leave Character Records unchanged');
select results_eq($$select to_jsonb(h) from public.party_handouts h order by id$$,$$select data from grid_handout_snapshot$$,'maps leave Handouts unchanged');
select * from finish();rollback;
